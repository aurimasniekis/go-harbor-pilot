    "@tanstack/react-query": "5.104.3",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-store": "0.7.7",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.14.13",
    "dayjs": "1.11.19",
    "echarts": "5.6.0",
    "lucide-react": "1.53.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "simple-icons": "16.33.0",
    "zod": "4.6.7"
